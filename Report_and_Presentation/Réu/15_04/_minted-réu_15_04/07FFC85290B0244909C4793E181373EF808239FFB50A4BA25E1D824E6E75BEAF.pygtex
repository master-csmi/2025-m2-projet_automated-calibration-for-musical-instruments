        \PYG{c+c1}{\PYGZsh{} conservative variables}
        \PYG{n}{pt} \PYG{o}{=} \PYG{n}{jnp}\PYG{o}{.}\PYG{n}{dot}\PYG{p}{(}\PYG{n}{ph}\PYG{p}{,} \PYG{n}{u\PYGZus{}cells}\PYG{p}{[}\PYG{n}{j}\PYG{p}{,}\PYG{l+m+mi}{0}\PYG{p}{])}  \PYG{c+c1}{\PYGZsh{} tilde p}
        \PYG{n}{vt} \PYG{o}{=} \PYG{n}{jnp}\PYG{o}{.}\PYG{n}{dot}\PYG{p}{(}\PYG{n}{ph}\PYG{p}{,} \PYG{n}{u\PYGZus{}cells}\PYG{p}{[}\PYG{n}{j}\PYG{p}{,}\PYG{l+m+mi}{1}\PYG{p}{])}  \PYG{c+c1}{\PYGZsh{} tilde v}

