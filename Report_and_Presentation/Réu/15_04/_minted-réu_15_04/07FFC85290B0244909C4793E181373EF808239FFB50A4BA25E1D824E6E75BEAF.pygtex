        \PYG{n}{p} \PYG{o}{=} \PYG{p}{(}\PYG{n}{c}\PYG{o}{*}\PYG{n}{S\PYGZus{}star}\PYG{o}{/}\PYG{n}{Sx}\PYG{p}{)} \PYG{o}{*} \PYG{n}{pt}
        \PYG{n}{v} \PYG{o}{=} \PYG{p}{(}\PYG{n}{Sx}\PYG{o}{/}\PYG{p}{(}\PYG{n}{c}\PYG{o}{*}\PYG{n}{S\PYGZus{}star}\PYG{p}{))} \PYG{o}{*} \PYG{n}{vt}

        \PYG{k}{return} \PYG{n}{jnp}\PYG{o}{.}\PYG{n}{stack}\PYG{p}{([}\PYG{n}{p}\PYG{p}{,} \PYG{n}{v}\PYG{p}{])}

